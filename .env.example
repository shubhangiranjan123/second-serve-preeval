# SECOND-SERVE AI backend configuration. Copy to .env and fill in ONE key.
# .env is git-ignored and is only read by server/index.mjs (never by the browser).

# Google AI Studio key (free tier): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Or use Claude instead: https://console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Force a provider when both keys are set: gemini | anthropic
# VISION_PROVIDER=gemini

# Optional
# VISION_TIMEOUT_MS=25000
# PORT=8787
