{
  "name": "second-serve-preeval",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:web": "vite",
    "server": "npm run build:core && node --disable-warning=ExperimentalWarning server/index.mjs",
    "build": "tsc -b && vite build && npm run build:core",
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs --static",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "fix-ai": "node fix-ai.mjs",
    "build:core": "vite build -c vite.server.config.ts --logLevel warn"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-gurmukhi": "^5.3.0",
    "lucide-react": "^1.72.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
